{
  "name": "@tanstack-router-testing/router-testing-core",
  "version": "0.0.0",
  "private": true,
  "description": "Internal runtime primitives for TanStack Router/Start test harnesses.",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack/history": "1.161.6",
    "@tanstack/router-core": "1.168.15"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "tsdown": "0.21.9",
    "vitest": "4.1.4"
  }
}
