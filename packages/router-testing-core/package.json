{
  "name": "@tanstack-router-testing/router-testing-core",
  "version": "0.0.0",
  "description": "Internal runtime primitives for TanStack Router/Start test harnesses.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/router-testing-core"
  },
  "author": "eve0415",
  "keywords": ["tanstack", "router", "testing", "vitest"],
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack/history": "1.161.6",
    "@tanstack/router-core": "1.168.16"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260424.2",
    "tsdown": "0.21.10",
    "vitest": "4.1.5"
  }
}
