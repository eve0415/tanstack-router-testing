{
  "name": "@tanstack-router-testing/router-testing-core",
  "version": "0.7.0",
  "description": "Internal runtime primitives for TanStack Router/Start test harnesses.",
  "keywords": [
    "router",
    "tanstack",
    "testing",
    "vitest"
  ],
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/router-testing-core"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "devDependencies": {
    "@tanstack/history": "catalog:",
    "@tanstack/router-core": "catalog:",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/history": "^1.0.0",
    "@tanstack/router-core": "^1.0.0"
  }
}
