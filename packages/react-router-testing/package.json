{
  "name": "@tanstack-router-testing/react-router-testing",
  "version": "0.7.0",
  "description": "Upstream-shaped test helpers for @tanstack/react-router: createTestRouter and createRouterHarness.",
  "keywords": [
    "react",
    "router",
    "tanstack",
    "testing",
    "vitest"
  ],
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/react-router-testing"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cleanup.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.mts",
      "import": "./dist/ssr.mjs"
    },
    "./cleanup": {
      "types": "./dist/cleanup.d.mts",
      "import": "./dist/cleanup.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "node ../../scripts/gen-vendor-smoke-tests.mjs && vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "devDependencies": {
    "@tanstack-router-testing/react-start-testing": "workspace:*",
    "@tanstack-router-testing/router-testing-core": "workspace:*",
    "@tanstack/history": "catalog:",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/router-core": "^1.171.15",
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "catalog:",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@tanstack/history": "^1.0.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/router-core": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
