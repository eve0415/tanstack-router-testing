{
  "name": "@tanstack-router-testing/react-router-testing",
  "version": "0.4.0",
  "description": "Upstream-shaped test helpers for @tanstack/react-router: createTestRouter and createRouterHarness.",
  "keywords": [
    "react",
    "router",
    "tanstack",
    "testing",
    "vitest"
  ],
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/react-router-testing"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.mts",
      "import": "./dist/ssr.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "node ../../scripts/gen-vendor-smoke-tests.mjs && vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack/history": "1.162.0",
    "@tanstack/router-core": "1.171.5"
  },
  "devDependencies": {
    "@tanstack-router-testing/react-start-testing": "workspace:*",
    "@tanstack-router-testing/router-testing-core": "workspace:*",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-router": "^1.170.7",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260522.1",
    "jsdom": "29.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "0.22.0",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.168.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
