{
  "name": "@tanstack-router-testing/react-router-testing",
  "version": "0.0.0",
  "description": "Upstream-shaped test helpers for @tanstack/react-router: createTestRouter and createRouterHarness.",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./ssr": {
      "types": "./dist/ssr.d.mts",
      "import": "./dist/ssr.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "node ../../scripts/gen-vendor-smoke-tests.mjs && vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack/history": "1.161.6",
    "@tanstack/router-core": "1.168.15"
  },
  "devDependencies": {
    "@tanstack-router-testing/react-start-testing": "workspace:*",
    "@tanstack-router-testing/router-testing-core": "workspace:*",
    "@tanstack/react-router": "1.168.23",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "jsdom": "29.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsdown": "0.21.9",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.168.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
