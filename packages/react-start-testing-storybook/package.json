{
  "name": "@tanstack-router-testing/react-start-testing-storybook",
  "version": "0.0.0",
  "description": "Storybook decorator for TanStack Start: wire CSF3 story parameters through createTestRouter + mockServerFn.",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack-router-testing/react-router-testing": "workspace:*",
    "@tanstack-router-testing/react-start-testing": "workspace:*",
    "@tanstack/router-core": "1.168.15"
  },
  "devDependencies": {
    "@storybook/react": "10.3.5",
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-start": "1.167.42",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "jsdom": "29.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "storybook": "10.3.5",
    "tsdown": "0.21.9",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@storybook/react": "^10.0.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.0.0"
  }
}
