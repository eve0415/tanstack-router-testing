{
  "name": "@tanstack-router-testing/react-start-testing-storybook",
  "version": "0.6.0",
  "description": "Storybook decorator for TanStack Start: wire CSF3 story parameters through createTestRouter + mockServerFn.",
  "keywords": [
    "decorator",
    "start",
    "storybook",
    "tanstack",
    "testing"
  ],
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/react-start-testing-storybook"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack-router-testing/react-router-testing": "workspace:*",
    "@tanstack-router-testing/react-start-testing": "workspace:*"
  },
  "devDependencies": {
    "@storybook/react": "10.4.1",
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.13",
    "@tanstack/router-core": "^1.171.6",
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "10.4.1",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@storybook/react": "^10.0.0",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.0",
    "@tanstack/router-core": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.0.0"
  }
}
