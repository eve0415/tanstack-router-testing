{
  "name": "@tanstack-router-testing/react-start-testing",
  "version": "0.7.0",
  "description": "Upstream-shaped test helpers for @tanstack/react-start: direct server function tests, mocks, env control, and Vitest wiring.",
  "keywords": [
    "react",
    "server-functions",
    "start",
    "tanstack",
    "testing",
    "vitest"
  ],
  "license": "MIT",
  "author": "eve0415",
  "repository": {
    "type": "git",
    "url": "https://github.com/eve0415/tanstack-router-testing.git",
    "directory": "packages/react-start-testing"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/cleanup.mjs"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    },
    "./shim": {
      "types": "./dist/shim.d.mts",
      "import": "./dist/shim.mjs"
    },
    "./server-shim": {
      "types": "./dist/server-shim.d.mts",
      "import": "./dist/server-shim.mjs"
    },
    "./server-entry-shim": {
      "types": "./dist/server-entry-shim.d.mts",
      "import": "./dist/server-entry-shim.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./cleanup": {
      "types": "./dist/cleanup.d.mts",
      "import": "./dist/cleanup.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack-router-testing/router-testing-core": "workspace:*",
    "cookie-es": "3.1.1",
    "h3-v2": "npm:h3@2.0.1-rc.22"
  },
  "devDependencies": {
    "@tanstack/react-router": "^1.170.8",
    "@tanstack/react-start": "^1.168.13",
    "@tanstack/router-plugin": "^1.168.11",
    "@tanstack/start-client-core": "^1.170.4",
    "@tanstack/start-fn-stubs": "1.162.0",
    "@tanstack/start-server-core": "^1.169.4",
    "@tanstack/start-storage-context": "^1.167.8",
    "@testing-library/react": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "vite": "8.0.16",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@tanstack-router-testing/react-router-testing": "workspace:^",
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.0",
    "@tanstack/router-plugin": "^1.0.0",
    "@tanstack/start-client-core": "^1.0.0",
    "@tanstack/start-fn-stubs": "^1.0.0",
    "@tanstack/start-server-core": "^1.0.0",
    "@tanstack/start-storage-context": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0 || ^8.0.0",
    "vitest": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack-router-testing/react-router-testing": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
