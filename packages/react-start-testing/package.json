{
  "name": "@tanstack-router-testing/react-start-testing",
  "version": "0.0.0",
  "description": "Upstream-shaped test helpers for @tanstack/react-start: direct server function tests, mocks, env control, and Vitest wiring.",
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./shim": {
      "types": "./dist/shim.d.mts",
      "import": "./dist/shim.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test:unit": "vitest run --passWithNoTests",
    "test:types": "tsgo --noEmit"
  },
  "dependencies": {
    "@tanstack-router-testing/router-testing-core": "workspace:*",
    "@tanstack/router-plugin": "1.167.22",
    "@tanstack/start-client-core": "1.167.17",
    "@tanstack/start-fn-stubs": "1.161.6",
    "@tanstack/start-storage-context": "1.166.29"
  },
  "devDependencies": {
    "@tanstack/react-router": "1.168.23",
    "@tanstack/react-start": "1.167.42",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "jsdom": "29.0.2",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsdown": "0.21.9",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.168.0",
    "@tanstack/react-start": "^1.167.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0 || ^8.0.0"
  }
}
