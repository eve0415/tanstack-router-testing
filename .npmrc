auto-install-peers=true
strict-peer-dependencies=false
shared-workspace-lockfile=true
save-workspace-protocol=rolling
prefer-workspace-packages=true
link-workspace-packages=true

# Hoist React + TanStack externals to repo root so vendored apps under
# vendor/** can resolve them during test runs without per-app installs.
# Without this, vendored files (whose dirs have no node_modules) can't
# find react/jsx-dev-runtime via Vite's resolver.
public-hoist-pattern[]=*react*
public-hoist-pattern[]=@tanstack/*
public-hoist-pattern[]=@testing-library/*
